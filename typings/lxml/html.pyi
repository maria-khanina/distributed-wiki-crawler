from collections.abc import Iterator

class HtmlElement:
    def make_links_absolute(self, base_url: str) -> None: ...
    def iterlinks(self) -> Iterator[tuple[HtmlElement, str | None, str, int]]: ...
    def xpath(self, path: str) -> list[str]: ...
    def text_content(self) -> str: ...

def fromstring(html: bytes) -> HtmlElement: ...
